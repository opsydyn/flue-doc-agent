# @defaultSensitive=false @defaultRequired=false
# @currentEnv=$APP_ENV
# ---

# Runtime environment name.
# @type=enum(development, preview, production, test)
APP_ENV=development

# OpenAI API key used by the Flue model provider.
# @sensitive @required @type=string(startsWith=sk-)
# @docs(https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# OpenAI model used only for the generated freshness page executive summary.
# @type=string
DOC_FRESHNESS_SUMMARY_MODEL=gpt-4.1-nano

# OpenAI model used for advisory semantic impact review of stale/warning docs.
# @type=string
DOC_FRESHNESS_ADVISORY_MODEL=gpt-4.1-mini

# One Dollar Stats API key used to fetch private analytics data.
# @sensitive @required @type=string
# @docs(https://onedollarstats.com/)
ONE_DOLLAR_STATS_API_KEY=

# One Dollar Stats site identifier for the deployed documentation site.
# @required @type=string
ODS_SITE_ID=

# Public One Dollar Stats site identifier exposed to the Starlight client bundle.
# @type=string
PUBLIC_ODS_SITE_ID=

# GitHub token used by Octokit and gh for repository metadata and issue sync.
# @sensitive @type=string
GH_TOKEN=

# GitHub Actions provided token fallback.
# @sensitive @type=string
GITHUB_TOKEN=

# GitHub repository in owner/name form.
# @required @type=string
GITHUB_REPOSITORY=

# GitHub ref name for Actions runs.
# @type=string
GITHUB_REF_NAME=main

# GitHub commit SHA for Actions runs.
# @type=string
GITHUB_SHA=

# 30-day page-view threshold for critical documentation freshness priority.
# @type=number(min=1, isInt=true)
PAGEVIEW_THRESHOLD=50

# Deployed docs base path used when mapping analytics URLs to Starlight files.
# @type=string
DOCS_BASE_PATH=/flue-doc-agent
