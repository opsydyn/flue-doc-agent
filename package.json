{
	"name": "doc-agent",
	"private": true,
	"type": "module",
	"workspaces": ["agents/*", "packages/*"],
	"scripts": {
		"check": "biome check --write .",
		"env:check": "varlock load --show-all",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"lint:md": "markdownlint-cli2",
		"fix:md": "markdownlint-cli2 --fix",
		"knip": "knip",
		"typecheck": "tsgo --noEmit"
	},
	"dependencies": {
		"effect": "beta"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.14",
		"@catenarycloud/linteffect": "0.0.4-1",
		"@effect/language-service": "^0.85.1",
		"@flue/cli": "^0.3.6",
		"@types/bun": "latest",
		"@typescript/native-preview": "latest",
		"bun-types": "latest",
		"knip": "^6.9.0",
		"markdownlint-cli2": "^0.22.1",
		"varlock": "^1.1.0"
	}
}
